NEXT_PUBLIC_SITE_URL=http://localhost:5173
RATE_LIMIT_SALT=replace-with-a-long-random-value

# Enable only with a provider endpoint that supports double opt-in and unsubscribe.
NEWSLETTER_PROVIDER_URL=
NEWSLETTER_PROVIDER_TOKEN=
NEWSLETTER_PROVIDER_VERIFY_URL=

# Configure both values only after uploading the real PDF.
NEXT_PUBLIC_FREE_PDF_TITLE=
NEXT_PUBLIC_FREE_PDF_URL=

# Show separate SMS/WhatsApp consent only when a messaging provider is ready.
NEXT_PUBLIC_PHONE_UPDATES_AVAILABLE=false
MESSAGING_PROVIDER_URL=
